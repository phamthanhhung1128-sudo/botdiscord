# ============================================================================
#  LÁ ĐU ĐỦ COMMUNITY — Mẫu cấu hình môi trường
#  ----------------------------------------------------------------------------
#  Cách dùng:  cp .env.example .env   rồi sửa các giá trị bên dưới.
#  TUYỆT ĐỐI KHÔNG commit file .env thật lên Git (đã có trong .gitignore).
# ============================================================================

# ---------------------------------------------------------------------------
# 1. CHUNG
# ---------------------------------------------------------------------------
NODE_ENV=development           # development | test | production
APP_NAME=Lá Đu Đủ Community
APP_URL=http://localhost:3000  # URL công khai, dùng để tạo link tuyệt đối
PORT=3000
HOST=0.0.0.0                   # 0.0.0.0 = nhận mọi interface (cần cho Docker/VPS)

# Số hop proxy tin cậy: 1 nếu chạy sau Nginx/Cloudflare, 0 nếu chạy trực tiếp.
# Để trống = tin tưởng toàn bộ (chỉ dùng khi biết chắc mình đang làm gì).
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# 2. BẢO MẬT  (BẮT BUỘC ĐỔI KHI CHẠY THẬT)
# ---------------------------------------------------------------------------
# Tạo khoá ngẫu nhiên 48 byte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=doi_thanh_chuoi_ngau_nhien_it_nhat_32_ky_tu
SESSION_MAX_AGE_HOURS=168      # 7 ngày
SESSION_COOKIE_NAME=ladudu.sid

BCRYPT_ROUNDS=12               # 10 = nhanh, 12 = cân bằng, 14 = rất chậm/an toàn
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300             # số request / IP / window cho toàn site
AUTH_RATE_LIMIT_MAX=12         # số lần đăng nhập/đăng ký / IP / window
CSRF_ENABLED=true              # chỉ tắt khi debug API bằng Postman

# ---------------------------------------------------------------------------
# 3. DATABASE (SQLite — không cần cài server riêng)
# ---------------------------------------------------------------------------
DATABASE_FILE=data/app.db      # dùng ':memory:' để chạy test
DB_BACKUP_KEEP=5               # số bản backup giữ lại trước mỗi lần migrate

# ---------------------------------------------------------------------------
# 4. ỨNG DỤNG
# ---------------------------------------------------------------------------
AUTO_MIGRATE=true              # tự chạy migration khi khởi động
LOG_LEVEL=info                 # debug | info | warn | error | silent
UPLOAD_MAX_MB=5                # giới hạn dung lượng ảnh tải lên (avatar, ảnh bìa)

# ---------------------------------------------------------------------------
# 5. TÀI KHOẢN QUẢN TRỊ GỐC  (dùng bởi: npm run db:seed)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@ladudu.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345     # BẮT BUỘC đổi trước khi deploy production
ADMIN_DISPLAY_NAME=Quản trị viên

# ---------------------------------------------------------------------------
# 6. BOT DISCORD  (Giai đoạn 4)
#    Tạo bot: https://discord.com/developers/applications
#    Bật ở Developer Portal:  Message Content Intent + Server Members Intent
# ---------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=              # ID server Discord (để đăng ký slash command nhanh)
DISCORD_LOG_CHANNEL_ID=        # kênh nhận log cảnh báo của bot
DISCORD_DEFAULT_VOLUME=60      # âm lượng mặc định của /play (1-100)
BOT_PREFIX=!
BOT_ACTIVITY=Lá Đu Đủ Community 🍃
