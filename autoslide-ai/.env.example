# OpenAI API key. Để trống sẽ dùng spec mẫu offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ứng dụng web
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# (Tùy chọn) true để bật DALL-E 3, có thể phát sinh phí API.
ENABLE_IMAGE_GENERATION=false

# (Tùy chọn) SQLite mặc định được tạo ở autoslide.db.
# DATABASE_URL=sqlite:///autoslide.db
